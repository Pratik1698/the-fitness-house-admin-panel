# =============================================================================
# THE FITNESS HOUSE — GYM MANAGEMENT ADMIN PANEL
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =============================================================================
# Instructions:
# 1. Copy this file to '.env' in the project root: cp .env.example .env
# 2. Replace the placeholder values with your real Supabase project credentials.
#
# SECURITY RULES:
# - Only variables prefixed with VITE_ are exposed to the client-side bundle.
# - NEVER put database administrator passwords, connection strings, or 
#   the Supabase 'service_role' key in this file or any frontend code.
# =============================================================================

# Supabase API URL (e.g., http://127.0.0.1:54321 for local Supabase CLI or https://<project>.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Public API Key (Safe for browser client usage with Row Level Security)
VITE_SUPABASE_ANON_KEY=your-anon-key-here
